# Database SQLite
DATABASE_URL="downshit.db"

# Aplikasi
PUBLIC_APP_NAME="Downshit Store"
ORIGIN="http://localhost:5173"          # produksi: https://domainanda.com (persis, tanpa slash akhir)
# CSRF_TRUSTED_ORIGINS=""               # origin tambahan (koma) yang boleh mengirim form; wildcard trycloudflare otomatis HANYA bila ORIGIN http/trycloudflare
CATALOG_REQUIRES_LOGIN="false"          # "true" = katalog hanya untuk pengguna login (SRS-F-005)
SESSION_DAYS="30"
TZ="Asia/Jakarta"                       # opsional: jam di log server berformat WIB

# Upload
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="2"

# Akun Awal (Seed)
SEED_OWNER_EMAIL="owner@downshit.local"
SEED_ADMIN_EMAIL="admin@downshit.local"
SEED_DEFAULT_PASSWORD="Ganti-Password-123!"
# SEED_ALLOW_PROD=true                  # hanya bila sengaja seed di produksi (password wajib unik >= 12 karakter)

# Pembayaran online Midtrans (opsional; kosong = hanya transfer bank manual)
# Ambil di dashboard Midtrans: Settings -> Access Keys. Sandbox: https://dashboard.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=""                  # sandbox berawalan SB-Mid-server-...
MIDTRANS_IS_PRODUCTION="false"          # "true" HANYA dengan Server Key produksi
# Payment Notification URL di dashboard Midtrans: https://DOMAIN-ANDA/api/midtrans/notification

# Payment gateway SIMULASI (mirip Midtrans, tanpa akun & tanpa uang sungguhan) untuk demo/pengujian.
# Aktif hanya bila MIDTRANS_SERVER_KEY kosong. JANGAN dipakai untuk toko yang menerima uang sungguhan.
PAYMENT_SIMULATOR="false"               # "true" = pakai simulator
# PAYMENT_SIMULATOR_ALLOW_PROD="true"   # build produksi (NODE_ENV=production) menolak simulator kecuali ini diisi "true"

# Email transaksional (opsional): lupa password pelanggan + notifikasi status pesanan
# Kosong = fitur email mati (login tetap menawarkan jalur "hubungi admin via WhatsApp").
# resend: https://resend.com (domain pengirim harus diverifikasi) · brevo: https://brevo.com (alamat pengirim diverifikasi)
# log = hanya mencetak email ke log server (untuk development, tidak mengirim apa pun)
MAIL_PROVIDER=""                        # resend | brevo | log
MAIL_API_KEY=""
MAIL_FROM="Downshit Store <no-reply@domainanda.com>"

# WhatsApp otomatis (opsional): kabar status pesanan ke pelanggan + pesanan baru ke WhatsApp toko
WA_PROVIDER=""                          # fonnte | log
WA_API_TOKEN=""

# Ongkir otomatis per tujuan & berat (opsional; kosong = ongkir flat). Kode pos asal diatur di Admin > Pengaturan
BITESHIP_API_KEY=""

# Pemantauan (opsional)
SENTRY_DSN=""                           # https://KUNCI@host/PROYEK (Sentry / GlitchTip)
LOG_LEVEL="info"                        # debug | info | warn | error
LOG_FORMAT="pretty"                     # json di produksi

# Maintenance Cron Token (>= 32 karakter acak; buat: openssl rand -hex 32)
CRON_SECRET="GANTI_DENGAN_STRING_ACAK"    # placeholder < 32 karakter sengaja membuat endpoint menolak semua permintaan

# ---------- KHUSUS PRODUKSI (adapter-node membaca dari process.env) ----------
# Jalankan dengan: node --env-file=.env build   (`node build` polos TIDAK membaca .env)
# BODY_SIZE_LIMIT=3M                    # bawaan 512K → upload 2 MB gagal (413) tanpa ini
# ADDRESS_HEADER=X-Forwarded-For        # agar getClientAddress() = IP asli di belakang Nginx.
# XFF_DEPTH=1                           #   JANGAN set bila diakses langsung tanpa proxy.
# HOST=127.0.0.1
# PORT=3000
