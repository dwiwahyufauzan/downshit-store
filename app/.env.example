# Database SQLite
DATABASE_URL="downshit.db"

# Aplikasi
PUBLIC_APP_NAME="Downshit Store"
ORIGIN="http://localhost:5173"          # produksi: https://domainanda.com (persis, tanpa slash akhir)
CATALOG_REQUIRES_LOGIN="false"          # "true" = katalog hanya untuk pengguna login (SRS-F-005)
SESSION_DAYS="30"
TZ="Asia/Jakarta"                       # opsional: jam di log server berformat WIB

# Upload
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="2"

# Akun Awal (Seed)
SEED_OWNER_EMAIL="owner@downshit.local"
SEED_ADMIN_EMAIL="admin@downshit.local"
SEED_DEFAULT_PASSWORD="Ganti-Password-123!"
# SEED_ALLOW_PROD=true                  # hanya bila sengaja seed di produksi (password wajib unik >= 12 karakter)

# Maintenance Cron Token (>= 32 karakter acak; buat: openssl rand -hex 32)
CRON_SECRET="GANTI_DENGAN_STRING_ACAK"    # placeholder < 32 karakter sengaja membuat endpoint menolak semua permintaan

# ---------- KHUSUS PRODUKSI (adapter-node membaca dari process.env) ----------
# Jalankan dengan: node --env-file=.env build   (`node build` polos TIDAK membaca .env)
# BODY_SIZE_LIMIT=3M                    # bawaan 512K → upload 2 MB gagal (413) tanpa ini
# ADDRESS_HEADER=X-Forwarded-For        # agar getClientAddress() = IP asli di belakang Nginx.
# XFF_DEPTH=1                           #   JANGAN set bila diakses langsung tanpa proxy.
# HOST=127.0.0.1
# PORT=3000
