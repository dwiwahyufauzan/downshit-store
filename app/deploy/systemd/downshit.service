# /etc/systemd/system/downshit.service
# sudo systemctl daemon-reload && sudo systemctl enable --now downshit
# Log: journalctl -u downshit -f
[Unit]
Description=Downshit Store (SvelteKit + SQLite)
After=network.target

[Service]
Type=simple
User=downshit
Group=downshit
WorkingDirectory=/srv/downshit/current
ExecStart=/usr/bin/node --env-file=/srv/downshit/shared/.env build
Restart=always
RestartSec=3
# hardening ringan. SQLite butuh menulis berkas .db, -wal, -shm DAN membuat berkas baru di folder data,
# jadi seluruh /srv/downshit/shared harus ReadWrite (data/, uploads/, backups/).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/downshit/shared

[Install]
WantedBy=multi-user.target
