# =============================================================================
# Downshit Store - variabel lingkungan PRODUKSI (SQLite + adapter-node)
# Salin ke /srv/downshit/shared/.env  ->  chmod 600  ->  JANGAN di-commit.
# Jalankan aplikasi dengan:  node --env-file=/srv/downshit/shared/.env build
# (perintah `node build` polos TIDAK membaca .env)
# =============================================================================

# --- Database (SQLite, satu berkas; WAJIB path ABSOLUT di produksi) ----------
# Folder induknya harus dapat ditulis oleh user aplikasi (SQLite membuat berkas -wal & -shm di situ).
DATABASE_URL="/srv/downshit/shared/data/downshit.db"

# --- Aplikasi -----------------------------------------------------------------
PUBLIC_APP_NAME="Downshit Store"
ORIGIN="https://toko.contoh.id"       # persis URL di browser (skema + host [+ port], tanpa slash akhir)
CATALOG_REQUIRES_LOGIN="true"         # SRS-F-005: katalog wajib login ("false" = katalog publik)
SESSION_DAYS="30"

# --- Upload (path ABSOLUT) ----------------------------------------------------
UPLOAD_DIR="/srv/downshit/shared/uploads"
MAX_UPLOAD_MB="2"

# --- adapter-node (dibaca dari process.env) ----------------------------------
HOST="127.0.0.1"                      # hanya Nginx/tunnel yang boleh mengakses
PORT="3000"
BODY_SIZE_LIMIT="3M"                  # default adapter 512K -> upload 2 MB gagal (413). Harus > MAX_UPLOAD_MB + overhead multipart
ADDRESS_HEADER="X-Forwarded-For"      # agar getClientAddress() = IP pengunjung (rate limit login), bukan 127.0.0.1
XFF_DEPTH="1"                         # jumlah proxy tepercaya (Nginx = 1). HAPUS keduanya bila akses langsung tanpa proxy

# --- Pemeliharaan terjadwal (POST /internal/maintenance) -----------------------
# buat: openssl rand -hex 32   (64 karakter; aplikasi menolak < 32 karakter)
CRON_SECRET="GANTI_HASIL_OPENSSL_RAND_HEX_32"

# --- Seed: JANGAN simpan di .env server. Berikan lewat command line saat seed pertama kali -----
# SEED_OWNER_EMAIL, SEED_ADMIN_EMAIL, SEED_DEFAULT_PASSWORD (>= 12 karakter), NODE_ENV=production, SEED_ALLOW_PROD=true
