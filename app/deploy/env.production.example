# =============================================================================
# Downshit Store - variabel lingkungan PRODUKSI (SQLite + adapter-node)
# Salin ke /srv/downshit/shared/.env  ->  chmod 600  ->  JANGAN di-commit.
# Jalankan aplikasi dengan:  node --env-file=/srv/downshit/shared/.env build
# (perintah `node build` polos TIDAK membaca .env)
# =============================================================================

# --- Database (SQLite, satu berkas; WAJIB path ABSOLUT di produksi) ----------
# Folder induknya harus dapat ditulis oleh user aplikasi (SQLite membuat berkas -wal & -shm di situ).
DATABASE_URL="/srv/downshit/shared/data/downshit.db"

# --- Aplikasi -----------------------------------------------------------------
PUBLIC_APP_NAME="Downshit Store"
ORIGIN="https://toko.contoh.id"       # persis URL di browser (skema + host [+ port], tanpa slash akhir)
CATALOG_REQUIRES_LOGIN="true"         # SRS-F-005: katalog wajib login ("false" = katalog publik)
SESSION_DAYS="30"

# --- Upload (path ABSOLUT) ----------------------------------------------------
UPLOAD_DIR="/srv/downshit/shared/uploads"
MAX_UPLOAD_MB="2"

# --- adapter-node (dibaca dari process.env) ----------------------------------
HOST="127.0.0.1"                      # hanya Nginx/tunnel yang boleh mengakses
PORT="3000"
BODY_SIZE_LIMIT="3M"                  # default adapter 512K -> upload 2 MB gagal (413). Harus > MAX_UPLOAD_MB + overhead multipart
ADDRESS_HEADER="X-Forwarded-For"      # agar getClientAddress() = IP pengunjung (rate limit login), bukan 127.0.0.1
XFF_DEPTH="1"                         # jumlah proxy tepercaya (Nginx = 1). HAPUS keduanya bila akses langsung tanpa proxy

# --- Pembayaran online Midtrans (opsional) ------------------------------------
# Kosong = hanya transfer bank manual. Server Key produksi: dashboard.midtrans.com -> Settings -> Access Keys
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION="true"
# PAYMENT_SIMULATOR hanya untuk demo: jangan diaktifkan di toko yang menerima uang sungguhan
# Isi di dashboard Midtrans (Settings -> Configuration):
#   Payment Notification URL = ${ORIGIN}/api/midtrans/notification
#   (Finish/Unfinish/Error Redirect URL dikirim aplikasi sendiri per transaksi)

# --- Email transaksional (lupa password pelanggan + notifikasi status pesanan) ---
# Kosong = fitur email mati (login tetap menawarkan jalur "hubungi admin via WhatsApp").
# resend: resend.com (verifikasi domain pengirim) · brevo: brevo.com (verifikasi alamat pengirim)
MAIL_PROVIDER=""                      # resend | brevo
MAIL_API_KEY=""
MAIL_FROM="Downshit Store <no-reply@toko.contoh.id>"

# --- WhatsApp otomatis (opsional; kosong = hanya tautan wa.me manual) -----------
# Fonnte (fonnte.com): sambungkan perangkat WhatsApp toko lewat QR, salin token perangkat.
# Dipakai untuk kabar status pesanan ke pelanggan + pesanan baru ke WhatsApp toko.
WA_PROVIDER=""                        # fonnte
WA_API_TOKEN=""

# --- Ongkir otomatis per tujuan & berat (opsional; kosong = ongkir flat) --------
# Biteship (biteship.com): API key dari dashboard. Kode pos asal & kurir diatur di Admin > Pengaturan.
BITESHIP_API_KEY=""

# --- Pemantauan ---------------------------------------------------------------
# Galat server & peramban dikirim ke Sentry/GlitchTip bila diisi (tanpa SDK; dedupe & batas 30/menit).
SENTRY_DSN=""                         # https://KUNCI@host/PROYEK
LOG_FORMAT="json"                     # satu baris JSON per log (siap untuk journald/Loki); "pretty" untuk dibaca manusia
LOG_LEVEL="info"                      # debug | info | warn | error
# Cek uptime eksternal (UptimeRobot/Better Stack): GET ${ORIGIN}/api/health  (200 ok/degraded, 503 down)
# Cron mati/aplikasi mati terdeteksi juga lewat heartbeat (healthchecks.io): isi salah satu/keduanya
HEARTBEAT_URL=""                      # dipanggil maintenance.sh (tiap 15 menit) HANYA bila pemeliharaan sukses
BACKUP_HEARTBEAT_URL=""               # dipanggil backup.sh HANYA bila backup (+ offsite) sukses

# --- Backup di luar server (rclone) -------------------------------------------
# Tanpa ini semua backup hanya ada di disk server yang sama. Remote dibuat dengan `rclone config`
# (S3, Backblaze B2, Google Drive, SFTP, ...); disarankan bertipe "crypt" agar terenkripsi sebelum keluar server.
OFFSITE_RCLONE_REMOTE=""              # mis. "b2crypt:downshit"
OFFSITE_KEEP_DAYS="60"

# --- Pemeliharaan terjadwal (POST /internal/maintenance) -----------------------
# buat: openssl rand -hex 32   (64 karakter; aplikasi menolak < 32 karakter)
CRON_SECRET="GANTI_HASIL_OPENSSL_RAND_HEX_32"

# --- Seed: JANGAN simpan di .env server. Berikan lewat command line saat seed pertama kali -----
# SEED_OWNER_EMAIL, SEED_ADMIN_EMAIL, SEED_DEFAULT_PASSWORD (>= 12 karakter), NODE_ENV=production, SEED_ALLOW_PROD=true
