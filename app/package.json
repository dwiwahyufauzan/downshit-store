{
	"name": "app",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node --env-file=.env build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:watch": "vitest",
		"test:unit": "vitest run --project unit",
		"test:int": "vitest run --project integration",
		"test:all": "vitest run",
		"test": "vitest run",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx scripts/seed.ts",
		"db:seed-produk": "tsx scripts/seed-produk.ts",
		"db:seed-ukuran": "tsx scripts/seed-ukuran.ts",
		"db:seed-riwayat": "tsx scripts/seed-riwayat.ts",
		"db:reset-password": "tsx scripts/reset-password.ts",
		"db:migrate-sync": "tsx scripts/migrate.ts",
		"db:schema-sql": "mkdir -p docs/lampiran && drizzle-kit export --sql > docs/lampiran/schema.sqlite.sql",
		"db:synthetic": "tsx tests/gen-synthetic.ts",
		"ops:backup": "bash deploy/scripts/backup.sh",
		"ops:restore-test": "bash deploy/scripts/restore-test.sh",
		"ops:maintenance": "bash deploy/scripts/maintenance.sh"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource/metal-mania": "^5.3.0",
		"@fontsource/unifrakturmaguntia": "^5.3.0",
		"@lucide/svelte": "^1.72.0",
		"@node-rs/argon2": "^2.2.2",
		"@types/three": "^0.187.0",
		"better-sqlite3": "^13.1.1",
		"dotenv": "^18.0.10",
		"hls.js": "^1.7.4",
		"opentype.js": "^2.0.0",
		"sharp": "^0.35.5",
		"three": "^0.187.0",
		"tsx": "^4.23.15",
		"zod": "^4.6.7"
	}
}
